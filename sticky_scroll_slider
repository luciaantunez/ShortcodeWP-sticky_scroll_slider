add_action('init', function () {
  add_shortcode('sticky_scroll_slider', function () {
    $imgs = [
      'https://orbis.uy/wp-content/uploads/2025/10/Captura-de-pantalla-2025-10-12-210426.png',
      'https://orbis.uy/wp-content/uploads/2025/10/Captura-de-pantalla-2025-10-12-210443.png',
      'https://orbis.uy/wp-content/uploads/2025/10/Captura-de-pantalla-2025-10-12-210455.png',
    ];

    $pin_desktop = '100vh';
    $pin_compact = '50vh';

    $inline_styles = sprintf(
      '--scroll-slider-slides:%d;--scroll-slider-pin-desktop:%s;--scroll-slider-pin-compact:%s;',
      count( $imgs ),
      $pin_desktop,
      $pin_compact
    );

    ob_start();
    ?>
      <div
        class="scroll-slider"
        data-images='<?php echo esc_attr( wp_json_encode( $imgs ) ); ?>'
        style="<?php echo esc_attr( $inline_styles ); ?>"
      >
        <div class="scroll-slider__pin" role="presentation">
          <figure class="scroll-slider__frame">
            <img class="scroll-slider__img" src="<?php echo esc_url( $imgs[0] ); ?>" alt="Galería scroll">
          </figure>
        </div>
      </div>
    <?php return ob_get_clean();
  });
});

add_action('wp_enqueue_scripts', function () {
  // CSS
  $css = <<<CSS
.scroll-slider {
  position: relative;
  --scroll-slider-slides: 1;
  --scroll-slider-pin-desktop: 100vh;
  --scroll-slider-pin-compact: 50vh;
  min-height: calc(var(--scroll-slider-pin-desktop) * var(--scroll-slider-slides));
  display: block;
  width: min(100%, 50vw);
  margin-left: auto;
}

.scroll-slider__pin {
  position: sticky;
  top: 0;
  height: var(--scroll-slider-pin-desktop);
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.scroll-slider__frame {
  width: 100%;
  height: 100%;
  display: block;
}

.scroll-slider__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity .3s ease;
  will-change: opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
}

@media (max-width: 1023px) {
  .scroll-slider {
    min-height: calc(var(--scroll-slider-pin-compact) * var(--scroll-slider-slides));
    width: 100%;
  }

  .scroll-slider__pin {
    top: auto;
    bottom: 0;
    height: var(--scroll-slider-pin-compact);
  }
}

@media (prefers-reduced-motion: reduce) {
  .scroll-slider__img {
    transition: none;
  }
}
CSS;
  wp_register_style('slider_personalizado_css', false);
  wp_enqueue_style('slider_personalizado_css');
  wp_add_inline_style('slider_personalizado_css', $css);

  // JS
  $js = <<<JS
  (function(){
    var raf = window.requestAnimationFrame || function(cb){ return setTimeout(cb, 16); };

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function preload(images) {
      images.forEach(function (src) {
        if (!src) {
          return;
        }
        var img = new Image();
        img.decoding = 'async';
        img.src = src;
      });
    }

    function init(slider) {
      if (!slider || slider.dataset.stickyReady) {
        return;
      }

      var imgEl = slider.querySelector('.scroll-slider__img');
      if (!imgEl) {
        return;
      }

      var images = [];
      try {
        images = JSON.parse(slider.getAttribute('data-images') || '[]');
      } catch (err) {
        images = [];
      }

      if (!images.length) {
        return;
      }

      slider.dataset.stickyReady = 'true';
      slider.style.setProperty('--scroll-slider-slides', images.length);

      if (images.length > 1) {
        preload(images.slice(1));
      }

      var current = -1;
      var sliderTop = 0;
      var sliderEnd = 0;
      var ticking = false;

      function swapTo(index) {
        if (index === current || index < 0 || index >= images.length) {
          return;
        }

        var nextSrc = images[index];
        if (!nextSrc) {
          return;
        }

        current = index;

        if (imgEl.getAttribute('src') === nextSrc) {
          imgEl.style.opacity = 1;
          return;
        }

        function handleLoad() {
          imgEl.removeEventListener('load', handleLoad);
          imgEl.style.opacity = 1;
        }

        imgEl.addEventListener('load', handleLoad);
        imgEl.style.opacity = 0;
        imgEl.src = nextSrc;

        if (imgEl.complete && imgEl.naturalWidth) {
          handleLoad();
        }
      }

      function recalc() {
        var rect = slider.getBoundingClientRect();
        sliderTop = rect.top + window.scrollY;
        sliderEnd = sliderTop + slider.offsetHeight - window.innerHeight;
        if (sliderEnd < sliderTop) {
          sliderEnd = sliderTop;
        }
      }

      function update() {
        ticking = false;
        var total = sliderEnd - sliderTop;
        var progress = total <= 0 ? 0 : (window.scrollY - sliderTop) / total;
        progress = clamp(progress, 0, 1);
        var frame = Math.round(progress * (images.length - 1));
        swapTo(frame);
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          raf(update);
        }
      }

      function onResize() {
        recalc();
        update();
      }

      var observer = new IntersectionObserver(function(entries){
        var entry = entries[0];
        if (!entry) {
          return;
        }

        if (entry.isIntersecting) {
          recalc();
          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onResize);
        } else {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onResize);
        }
      }, { threshold: 0 });

      observer.observe(slider);

      swapTo(0);
    }

    function initAll(root) {
      (root || document).querySelectorAll('.scroll-slider').forEach(init);
    }

    document.addEventListener('DOMContentLoaded', function () {
      initAll(document);
    });

    function hookElementor() {
      if (!window.elementorFrontend || !window.elementorFrontend.hooks) {
        return;
      }

      var hook = window.elementorFrontend.hooks;
      var handler = function(scope){
        if (!scope) {
          initAll(document);
          return;
        }
        var context = scope[0] || scope;
        initAll(context instanceof Element ? context : document);
      };

      hook.addAction('frontend/element_ready/global', handler);
      hook.addAction('frontend/element_ready/widget', handler);
    }

    if (window.elementorFrontend && window.elementorFrontend.hooks) {
      hookElementor();
    } else if (window.jQuery && window.jQuery(window).on) {
      window.jQuery(window).on('elementor/frontend/init', hookElementor);
    } else {
      window.addEventListener('elementor/frontend/init', hookElementor);
    }

    if ('MutationObserver' in window) {
      var mo = new MutationObserver(function(mutations){
        mutations.forEach(function(record){
          record.addedNodes.forEach(function(node){
            if (!(node instanceof Element)) {
              return;
            }
            if (node.matches && node.matches('.scroll-slider')) {
              init(node);
            }
            if (node.querySelectorAll) {
              node.querySelectorAll('.scroll-slider').forEach(init);
            }
          });
        });
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
    }
  })();
JS;
  wp_register_script('slider_personalizado_js', false, [], null, true);
  wp_enqueue_script('slider_personalizado_js');
  wp_add_inline_script('slider_personalizado_js', $js);
});
